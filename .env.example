# ─── Solardapt environment ───────────────────────────────────────────────────
# Set these in Vercel → Settings → Environment Variables (then redeploy), or copy
# to .env.local for local development. Never commit real values.
# Every variable is optional: the site builds and runs with all of them blank.

# Site
NEXT_PUBLIC_SITE_URL="https://solardapt.com"

# Booking: your Cal.com planning-call event link. Blank → /book offers email + phone.
NEXT_PUBLIC_BOOKING_URL=""

# Enquiry form → Make.com custom webhook URL. Blank → the form is hidden.
LEAD_WEBHOOK_URL=""
# Optional shared secret, sent as the x-solardapt-secret header; check it in Make.
LEAD_WEBHOOK_SECRET=""

# Legal identity shown on /privacy and /legal. Blank lines are left out.
NEXT_PUBLIC_LEGAL_NAME=""        # e.g. "Navin Sonsana" (sole trader) or "Solardapt Ltd"
NEXT_PUBLIC_LEGAL_ADDRESS=""
NEXT_PUBLIC_COMPANY_NUMBER=""    # limited companies only
NEXT_PUBLIC_ICO_NUMBER=""        # leave blank if the ICO self-assessment says no fee is due
