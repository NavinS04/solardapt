# ─── Solardapt environment ───────────────────────────────────────────────────
# Copy to .env and fill. Never commit real secrets. See docs/RUNBOOK.md.
#
# The backend is thin: validate → consent-gate → fire conversion events →
# push the lead to GoHighLevel (GHL). GHL is the system of record for leads,
# pipeline, nurture (SMS + email) and reminders.

# Site
NEXT_PUBLIC_SITE_URL="https://solardapt.com"

# ─── GoHighLevel (lead handoff) ──────────────────────────────────────────────
# Create a Workflow in GHL with an "Inbound Webhook" trigger and paste its URL.
GHL_INBOUND_WEBHOOK_URL="https://services.leadconnectorhq.com/hooks/..."
GHL_MODE="webhook"          # webhook | api
# GHL_API_KEY=""            # only if/when switching GHL_MODE=api
# GHL_LOCATION_ID=""        # only if/when switching GHL_MODE=api

# ─── Booking (Calendly) ──────────────────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/navinsonsana-solardapt/30min"
# Signing key returned when creating the Calendly webhook subscription
# (POST api.calendly.com/webhook_subscriptions → /api/webhooks/calendly).
CALENDLY_WEBHOOK_SIGNING_KEY=""
# Optional: separate GHL inbound-webhook workflow for bookings; falls back to
# GHL_INBOUND_WEBHOOK_URL when unset.
GHL_BOOKING_WEBHOOK_URL=""

# ─── Conversion tracking ─────────────────────────────────────────────────────
# Meta Conversions API (CAPI) + Pixel (server events deduped with the Pixel)
NEXT_PUBLIC_META_PIXEL_ID=""
META_PIXEL_ID=""
META_CAPI_TOKEN=""
META_DATASET_ID=""

# Analytics (consent-gated)
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""

# Marketing video (VSL)
NEXT_PUBLIC_VSL_URL=""

# Review-platform badges — flip to "true" ONLY when the account genuinely exists
NEXT_PUBLIC_BADGE_GOOGLE="false"
NEXT_PUBLIC_BADGE_TRUSTPILOT="false"
NEXT_PUBLIC_BADGE_META_PARTNER="false"
NEXT_PUBLIC_BADGE_CLUTCH="false"

# Error monitoring (optional)
SENTRY_DSN=""

# Compliance — version stamped onto every consent audit record
POLICY_VERSION="2026-06-01"

# ─── Leads scraper (internal tool: tools/leads) ──────────────────────────────
# Optional. The tool runs keyless (OpenStreetMap) without any of these; the keys
# unlock better discovery/enrichment. Run: npm run leads -- --help
# Google Places (New) — enables `--source places` (billed per request).
GOOGLE_PLACES_API_KEY=""
# Hunter.io — fills role-based emails per domain when set.
HUNTER_API_KEY=""
# Default do-not-contact file (emails / domains / phones, one per line).
LEADS_SUPPRESS_FILE=""
# Override the crawler User-Agent (identify yourself + a contact URL).
LEADS_USER_AGENT=""
