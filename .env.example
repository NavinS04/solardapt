# ─── Solardapt environment ───────────────────────────────────────────────────
# Copy to .env and fill. Never commit real secrets. See docs/RUNBOOK.md.

# Site
NEXT_PUBLIC_SITE_URL="https://solardapt.com"

# Database (Neon / Supabase Postgres in prod)
DATABASE_URL="postgresql://user:password@localhost:5432/solardapt"

# Redis (Upstash) — caching, rate-limit buckets, queue
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Auth (Clerk) — admin/CRM RBAC
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM="Solardapt <hello@solardapt.com>"

# SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Booking (Calendly)
NEXT_PUBLIC_CALENDLY_URL=""
CALENDLY_WEBHOOK_SECRET=""

# Meta Conversions API (CAPI) + Pixel
NEXT_PUBLIC_META_PIXEL_ID=""
META_PIXEL_ID=""
META_CAPI_TOKEN=""
META_DATASET_ID=""

# Analytics (consent-gated)
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""

# Marketing video (VSL)
NEXT_PUBLIC_VSL_URL=""

# Review-platform badges — flip to "true" ONLY when the account genuinely exists
NEXT_PUBLIC_BADGE_GOOGLE="false"
NEXT_PUBLIC_BADGE_TRUSTPILOT="false"
NEXT_PUBLIC_BADGE_META_PARTNER="false"
NEXT_PUBLIC_BADGE_CLUTCH="false"

# Error monitoring
SENTRY_DSN=""

# Compliance
POLICY_VERSION="2026-06-01"
